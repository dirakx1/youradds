# Required PostgreSQL URLs. Use the Supabase direct endpoint for IPv6-capable
# persistent servers, or the session pooler for IPv4-only hosts. URL-encode
# password characters. Remote URLs must include sslmode=require or verify-full.
DATABASE_URL=
MIGRATION_DATABASE_URL=

# Keep these stable across deployments. Back up the existing Fernet key and
# media/jobs directories before cutover; do not generate a replacement key.
YOURADS_SECRET_KEY=
YOURADS_SECRET_KEY_FILE=./data/.secret_key
YOURADS_CREATIVES=./data/creatives

ALLOW_SIGNUP=true
# Obtain these from the dedicated yourads Clerk development instance.
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_JWT_KEY=
CLERK_ISSUER=
CLERK_AUTHORIZED_PARTIES=http://localhost:8000
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5
SHARED_HIGGSFIELD=false
HIGGSFIELD_API_KEY=
HIGGSFIELD_API_SECRET=
HIGGSFIELD_MODEL=z-image/turbo
HIGGSFIELD_RESOLUTION=1k
SCENE_MAX_USD=0.5
VIDEO_MAX_USD=3
