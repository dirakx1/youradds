# Server settings only. Each USER adds their own Meta / TikTok / Google / WhatsApp / Higgsfield
# credentials in the app (Connections page); they are stored encrypted per account.

ANTHROPIC_API_KEY=                  # server-wide: powers copy, chat and the WhatsApp agent for all users
AI_MODEL=claude-sonnet-5-5

# Accounts
ALLOW_SIGNUP=true                   # false = only existing accounts can log in
SESSION_DAYS=30
COOKIE_SECURE=false                 # set true behind HTTPS (also auto-enabled when the request is https)
# Plans and limits (see app/billing.py). Admins can change users' plans and grant credits on the Plan & usage page.
ADMIN_EMAILS=                       # comma-separated; empty = the first account is the admin
DEFAULT_PLAN=free                   # plan for accounts nobody has assigned one to

# Encryption key for stored credentials. If unset, one is generated in backend/data/.secret_key.
# BACK IT UP: without it, saved credentials cannot be decrypted. Generate: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
YOURADS_SECRET_KEY=

# Higgsfield (AI scenes + video). Users bring their own key (billed to them).
# Set SHARED_HIGGSFIELD=true ONLY if you want users without a key to spend YOUR key's balance.
SHARED_HIGGSFIELD=false
HIGGSFIELD_API_KEY=                 # ID:SECRET, used only when SHARED_HIGGSFIELD=true
HIGGSFIELD_MODEL=z-image/turbo      # or higgsfield-ai/soul/v2/standard
HIGGSFIELD_RESOLUTION=1k            # 1k | 2k (soul: 720p | 1080p)
SCENE_MAX_USD=0.50                  # refuse a request whose estimated scene cost exceeds this
VIDEO_MAX_USD=3.00                  # refuse a run whose estimated cost exceeds this (720p ~ $0.46/s, 480p ~ $0.21/s per clip)
